#!/usr/bin/env sh
# --- BEGIN BEADS INTEGRATION ---
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  bd hooks run pre-commit "$@"
  _bd_exit=$?
  if [ $_bd_exit -ne 0 ] && [ $_bd_exit -ne 3 ]; then exit $_bd_exit; fi
fi
# --- END BEADS INTEGRATION ---
REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
PY_EXE=""
for cand in "$REPO_TOP/.venv/Scripts/python.exe" "$REPO_TOP/.venv/bin/python"; do
  if [ -x "$cand" ]; then
    PY_EXE="$cand"
    break
  fi
done
if [ -z "$PY_EXE" ]; then
  if command -v python3 >/dev/null 2>&1; then PY_EXE="python3"; else PY_EXE="python"; fi
fi
"$PY_EXE" -m tools.sdlc_gate git-pre-commit --repo-root "$REPO_TOP"
exit $?
