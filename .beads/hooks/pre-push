#!/usr/bin/env sh
_push_stdin=""
if [ ! -t 0 ]; then
  _push_stdin=$(cat)
fi
if command -v bd >/dev/null 2>&1; then
  export BD_GIT_HOOK=1
  if [ -n "$_push_stdin" ]; then
    printf '%s\n' "$_push_stdin" | bd hooks run pre-push "$@"
  else
    bd hooks run pre-push "$@" </dev/null
  fi
  _bd_exit=$?
  if [ $_bd_exit -ne 0 ] && [ $_bd_exit -ne 3 ]; then exit $_bd_exit; fi
fi
REPO_TOP=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
PY_EXE=""
for cand in "$REPO_TOP/.venv/Scripts/python.exe" "$REPO_TOP/.venv/bin/python"; do
  if [ -x "$cand" ]; then
    PY_EXE="$cand"
    break
  fi
done
if [ -z "$PY_EXE" ]; then
  if command -v python3 >/dev/null 2>&1; then PY_EXE="python3"; else PY_EXE="python"; fi
fi
printf '%s\n' "$_push_stdin" | "$PY_EXE" -m tools.sdlc_gate git-pre-push --repo-root "$REPO_TOP" --read-stdin
exit $?
