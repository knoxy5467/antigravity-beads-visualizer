{
  "bv-sdlc-session-start": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python hooks/session_start.py",
        "timeout": 20
      }
    ]
  },
  "bv-sdlc-mutation-gate": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/pre_tool_gate.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "bv-sdlc-scry-sync": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/post_tool_scry.py",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "bv-sdlc-stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "python hooks/stop_gate.py",
        "timeout": 30
      }
    ]
  }
}
